#include <chrono>
#include <iostream>
#include <string>
#include <utility>
 
class Prescription {
    int n_;
    std::string* medicines_;
public:
    explicit Prescription(int count) : n_(count), medicines_(new std::string[count]) {}
    Prescription(const Prescription& other) : n_(other.n_), medicines_(new std::string[other.n_]) {
        std::cout << "copy ";
        for (int i=0;i<n_;++i) medicines_[i]=other.medicines_[i];
    }
    Prescription& operator=(const Prescription& other) {
        if (this != &other) {
            std::string* fresh = new std::string[other.n_];
            for (int i=0;i<other.n_;++i) fresh[i]=other.medicines_[i];
            delete[] medicines_; medicines_=fresh; n_=other.n_;
        }
        return *this;
    }
    ~Prescription() { delete[] medicines_; }
    void set(int i,const std::string& m) { medicines_[i]=m; }
    const std::string& get(int i) const { return medicines_[i]; }
    int size() const { return n_; }
};
void byValue(Prescription) { std::cout << "value "; }
void byRef(const Prescription&) { std::cout << "ref "; }
int main() {
    Prescription p(2); p.set(0,"Paracetamol"); p.set(1,"ORS");
    Prescription q=p; q.set(1,"Cetirizine");
    Prescription r(1); r=p; r=p;
    p.set(0,"Ibuprofen");
    std::cout << p.get(0)<<' '<<p.get(1)<<" | "<<q.get(0)<<' '<<q.get(1)
              <<" | "<<r.get(0)<<' '<<r.get(1)<<'\n';
    byValue(p); byRef(p); std::cout << '\n';
    for (int n : {10,1000,100000}) {
        Prescription sample(n);
        for(int i=0;i<n;++i) sample.set(i,"medicine");
        constexpr int reps=20;
        auto start=std::chrono::steady_clock::now();
        for(int i=0;i<reps;++i) { Prescription copy=sample; (void)copy.size(); }
        auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(
            std::chrono::steady_clock::now()-start).count();
        std::cout<<n<<" medicines average ns="<<ns/reps<<'\n';
    }
}
