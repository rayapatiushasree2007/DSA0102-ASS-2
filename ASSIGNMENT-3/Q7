#include <cmath>
#include <iomanip>
#include <iostream>
#include <stdexcept>
 
class Complex {
    double re_,im_;
public:
    Complex():re_(0),im_(0){}
    Complex(double r):re_(r),im_(0){}
    Complex(double r,double i):re_(r),im_(i){}
    double real() const{return re_;} double imag() const{return im_;}
    double magnitude() const{return std::hypot(re_,im_);}
    Complex operator+(const Complex& z)const{return {re_+z.re_,im_+z.im_};}
    Complex operator-(const Complex& z)const{return {re_-z.re_,im_-z.im_};}
    Complex operator*(const Complex& z)const{return {re_*z.re_-im_*z.im_,re_*z.im_+im_*z.re_};}
    Complex operator/(const Complex& z)const{
        double d=z.re_*z.re_+z.im_*z.im_;
        if(d==0.0) throw std::domain_error("division by zero impedance");
        return {(re_*z.re_+im_*z.im_)/d,(im_*z.re_-re_*z.im_)/d};
    }
    bool operator==(const Complex& z)const{
        constexpr double eps=1e-9; return std::abs(re_-z.re_)<eps&&std::abs(im_-z.im_)<eps;
    }
    friend std::ostream& operator<<(std::ostream& o,const Complex& z){
        return o<<z.re_<<(z.im_<0?" - j":" + j")<<std::abs(z.im_);
    }
};
int main(){
    const Complex resistor(10,0),inductor(0,5);
    Complex series=resistor+inductor;
    Complex parallel=(resistor*inductor)/(resistor+inductor);
    std::cout<<std::fixed<<std::setprecision(4);
    std::cout<<"Series: "<<series<<", |Z|="<<series.magnitude()<<'\n';
    std::cout<<"Parallel: "<<parallel<<", |Z|="<<parallel.magnitude()<<'\n';
    try { (void)(resistor/Complex()); }
    catch(const std::domain_error& e){std::cout<<e.what()<<'\n';}
}
